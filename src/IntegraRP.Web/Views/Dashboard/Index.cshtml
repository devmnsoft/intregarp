@model IntegraRP.Web.ViewModels.Dashboard.DashboardViewModel
@{ ViewData["Title"] = "Dashboard executivo"; ViewData["Description"] = "Priorize riscos, gargalos e próximas ações com dados operacionais reais.";  ViewData["ModuleGuideKey"] = "Dashboard"; ViewData["ModuleGuideTitle"] = "Acompanhe KPIs, riscos e próximos passos da operação"; ViewData["ModuleGuideText"] = "Use o dashboard no início do turno e em reuniões rápidas para identificar gargalos, falhas parciais de consulta e decisões que exigem ação."; ViewData["ModuleGuideActions"] = "Atualizar indicadores; Abrir Central de Ações; Investigar KPIs com alerta; Priorizar tarefas vencidas"; ViewData["ModuleGuideOutcome"] = "Resultado esperado: operação priorizada sem perder dados carregados quando algum serviço falhar.";}
@section Styles { <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" /> }
<partial name="_AppModuleGuide" />
<section class="dashboard-hero panel" aria-labelledby="dashboard-heading">
  <div><p class="eyebrow">Bom trabalho</p><h2 id="dashboard-heading">Visão executiva da operação — @Model.TenantName</h2><p>Período atual · última atualização @Model.LastUpdatedAt.ToLocalTime().ToString("g")</p></div>
  <div class="d-flex gap-2"><button class="btn btn-primary" type="button" data-refresh-dashboard>Atualizar</button><a class="btn btn-outline-primary" href="/tasks/my">Ver tarefas</a></div>
</section>
<section class="kpi-grid" aria-label="Indicadores principais">
@foreach (var kpi in Model.Kpis)
{
  <article class="kpi-card" data-status="@kpi.Status"><app-icon name="@kpi.Icon" /><p>@kpi.Title</p><strong>@kpi.Value</strong><span>@kpi.Context</span><a href="@kpi.DetailUrl">Abrir detalhe</a></article>
}
</section>
<section class="dashboard-grid">
  <article class="panel"><h2>O que precisa da sua atenção</h2><p class="text-muted">Não foi possível consultar alertas operacionais. Atualize a página ou abra a Central de Ações.</p></article>
  <article class="panel"><h2>Minhas próximas tarefas</h2><p class="text-muted">A consulta de tarefas não respondeu. Acesse sua fila para tentar novamente.</p></article>
  <article class="panel"><h2>Processos em andamento</h2><p class="text-muted">A consulta de processos não respondeu. Abra o Integra Flow para consultar a operação.</p></article>
  <article class="panel"><h2>Saúde dos módulos</h2><p class="text-muted">Os indicadores de disponibilidade não puderam ser consolidados nesta atualização.</p></article>
</section>
@section Scripts { <script src="~/js/pages/dashboard.js" asp-append-version="true" defer></script> }
