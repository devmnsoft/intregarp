@{ ViewData["Title"] = "Clientes"; ViewData["Description"] = "Cadastre clientes e mantenha seus dados comerciais."; }
<section class="integrarp-page" data-page-title="Clientes">
  <partial name="_PageHeader" />
  <div id="customers-status" class="alert alert-info" role="status">Carregando clientes...</div>
  <form id="customer-form" class="card p-3 mb-3" aria-busy="false">
    <input type="hidden" name="id" />
    <div class="row g-3">
      <div class="col-md-4"><label class="form-label" for="customer-name">Nome ou razão social</label><input id="customer-name" class="form-control" name="name" required /></div>
      <div class="col-md-3"><label class="form-label" for="customer-document">CPF/CNPJ</label><input id="customer-document" class="form-control" name="document" inputmode="numeric" /></div>
      <div class="col-md-3"><label class="form-label" for="customer-email">E-mail</label><input id="customer-email" class="form-control" name="email" type="email" /></div>
      <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit"><app-icon name="success" /> Salvar</button></div>
    </div>
  </form>
  <div class="table-responsive card"><table class="table table-hover mb-0"><thead><tr><th>Nome</th><th>Documento</th><th>E-mail</th><th>Status</th></tr></thead><tbody id="customers-list"></tbody></table></div>
  <div id="customers-empty" class="p-4 text-center d-none">Nenhum cliente encontrado. Use o formulário acima para começar.</div>
</section>
@section Scripts { <script type="module" src="~/js/pages/customers.js" asp-append-version="true"></script> }
